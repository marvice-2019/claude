  "mainEntity": [
    {
      "@type": "Question",
      "name": "What does Marvice Media do?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Marvice Media is a digital growth agency founded in 2017, with offices in Bengaluru and Chennai. It works through three brands: Onscreens for branding, digital marketing, SEO, generative engine optimization (GEO), and web and app development; Worxforu for business process automation, custom software and AI development; and Conxyou for events, PR, corporate gifting and photography."
      }
    },
    {
      "@type": "Question",
      "name": "Where are Marvice Media's offices?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Marvice Media has two offices in India: No.38, 3rd Floor, Green Leaf Extension, 3rd Cross, 80 Feet Road, 4th Block, Koramangala, Bengaluru, Karnataka 560034, and Prestige Palladium Bayan, 8th Floor, 43/1 Greams Road, Nungambakkam, Chennai, Tamil Nadu 600006. The agency works with clients across India and the United Kingdom (marvice.co.uk)."
      }
    },
    {
      "@type": "Question",
      "name": "What is generative engine optimization (GEO)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Generative engine optimization is the practice of making a brand easy for AI assistants such as ChatGPT, Google AI Overviews, Gemini, Perplexity and Claude to find, understand and cite. It combines structured data, entity consistency across the web, citable answer-style content, llms.txt and AI-crawler access. Marvice Media runs GEO alongside traditional SEO so a business ranks on Google and is named in AI answers."
      }
    },
    {
      "@type": "Question",
      "name": "How is GEO different from SEO?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "SEO aims to rank a page in Google's list of links. GEO aims to get a brand mentioned or cited inside an AI-generated answer, where there is often no list to click. Both rely on crawlable, trustworthy content, but GEO puts extra weight on clear entity data (schema, consistent name-address-phone), third-party mentions and short factual passages that an AI can quote."
      }
    },
    {
      "@type": "Question",
      "name": "How long does SEO or GEO take to show results?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Technical fixes such as schema, indexing clean-up and AI-crawler access are usually picked up within 2–6 weeks. Local rankings in Bengaluru typically move within 2–4 months. Competitive national keywords and consistent AI citations usually take 4–9 months of content and authority building."
      }
    },
    {
      "@type": "Question",
      "name": "Which industries does Marvice Media work with?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Marvice Media works with startups, SMEs and established companies, with particular depth in hospitality and food & beverage (restaurants, pubs, clubs and events), retail and e-commerce, professional services, education (LMS) and B2B technology."
      }
    },
    {
      "@type": "Question",
      "name": "Does Marvice Media build websites and mobile apps?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Through its Onscreens brand, Marvice Media designs and develops business websites, e-commerce stores and iOS/Android mobile apps, built SEO- and GEO-ready from launch with schema, fast load times and analytics set up."
      }
    },
    {
      "@type": "Question",
      "name": "Can Marvice Media automate business processes with AI?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Worxforu, Marvice Media's software brand, builds business process automation, CRM and ERP portals, custom software and AI-based tools such as AI voice agents, chatbots and workflow automation, integrated with the tools a business already uses."
      }
    },
    {
      "@type": "Question",
      "name": "How do I get a quote from Marvice Media?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Call +91 80562 91930, email info@marvice.in, or use the contact form at marvice.in/contact-us. Marvice Media offers a free initial GEO and SEO visibility check for new enquiries."
      }
    }
  ]
