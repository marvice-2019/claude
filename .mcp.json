{
  "mcpServers": {
    "seomonster": {
      "command": "uvx",
      "args": [
        "seo-monster"
      ],
      "env": {
        "SEO_MCP_GOOGLE_OAUTH_CLIENT": "${SEO_MCP_GOOGLE_OAUTH_CLIENT:-}",
        "SEO_MCP_GOOGLE_TOKEN": "${SEO_MCP_GOOGLE_TOKEN:-}",
        "SEO_MCP_GSC_DEFAULT_SITE": "${SEO_MCP_GSC_DEFAULT_SITE:-}",
        "SEO_MCP_GA4_PROPERTY_ID": "${SEO_MCP_GA4_PROPERTY_ID:-}",
        "PSI_API_KEY": "${PSI_API_KEY:-}",
        "CF_API_TOKEN": "${CF_API_TOKEN:-}",
        "CF_ZONE": "${CF_ZONE:-}",
        "SEO_MCP_INDEXNOW_KEY": "${SEO_MCP_INDEXNOW_KEY:-}",
        "SEO_MCP_INDEXNOW_KEY_LOCATION": "${SEO_MCP_INDEXNOW_KEY_LOCATION:-}",
        "SEO_MCP_ALLOW_DESTRUCTIVE": "${SEO_MCP_ALLOW_DESTRUCTIVE:-}"
      }
    },
    "hostinger-hosting": {
      "command": "npx",
      "args": [
        "-y",
        "--package=@hostinger/mcp@latest",
        "hostinger-hosting-mcp"
      ],
      "env": {
        "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}"
      }
    },
    "hostinger-domains": {
      "command": "npx",
      "args": [
        "-y",
        "--package=@hostinger/mcp@latest",
        "hostinger-domains-mcp"
      ],
      "env": {
        "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}"
      }
    },
    "hostinger-dns": {
      "command": "npx",
      "args": [
        "-y",
        "--package=@hostinger/mcp@latest",
        "hostinger-dns-mcp"
      ],
      "env": {
        "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}"
      }
    },
    "hostinger-billing": {
      "command": "npx",
      "args": [
        "-y",
        "--package=@hostinger/mcp@latest",
        "hostinger-billing-mcp"
      ],
      "env": {
        "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}"
      }
    },
    "hostinger-reach": {
      "command": "npx",
      "args": [
        "-y",
        "--package=@hostinger/mcp@latest",
        "hostinger-reach-mcp"
      ],
      "env": {
        "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}"
      }
    },
    "hostinger-vps": {
      "command": "npx",
      "args": [
        "-y",
        "--package=@hostinger/mcp@latest",
        "hostinger-vps-mcp"
      ],
      "env": {
        "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}"
      }
    },
    "hostinger-ecommerce": {
      "command": "npx",
      "args": [
        "-y",
        "--package=@hostinger/mcp@latest",
        "hostinger-ecommerce-mcp"
      ],
      "env": {
        "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}"
      }
    },
    "conxyou-site": {
      "type": "http",
      "url": "https://websites-agents.hostinger.com/conxyou.com/mcp"
    },
    "wpvibe": {
      "type": "http",
      "url": "https://mcp.wpvibe.ai/mcp"
    },
    "n8n-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "n8n-mcp@latest"
      ],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_API_URL": "${N8N_API_URL:-}",
        "N8N_API_KEY": "${N8N_API_KEY:-}",
        "N8N_MCP_ACCESS_TOKEN": "${N8N_MCP_ACCESS_TOKEN:-}"
      }
    }
  }
}
