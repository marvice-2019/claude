# ═══════════════════════════════════════════
# AI Voice Agent — Environment Configuration
# ═══════════════════════════════════════════
# Copy this to .env and fill in your actual values.
# NEVER commit the .env file with real credentials.

# ── n8n Configuration ──
N8N_BASE_URL=https://your-n8n-instance.com
N8N_ENCRYPTION_KEY=your-encryption-key

# ── Exotel (Voice Gateway — India) ──
EXOTEL_SID=your-exotel-account-sid
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_API_TOKEN=your-exotel-api-token
EXOTEL_SUBDOMAIN=api.exotel.com

# ── Twilio (Voice Gateway) ──
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+91XXXXXXXXXX

# ── Sarvam AI (Speech-to-Text: Saaras v4, Text-to-Speech: Bulbul v3) ──
# Used by n8n-import-complete.json for both listening and the agent's voice.
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_SPEAKER=priya
# Other Bulbul v3 voices: kavya, ritu, neha, shruti, rahul, aditya (see docs.sarvam.ai)

# ── Deepgram (Speech-to-Text — legacy workflows only) ──
DEEPGRAM_API_KEY=your-deepgram-api-key

# ── ElevenLabs (Text-to-Speech — legacy workflows only) ──
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-chosen-voice-id
# Recommended voices: "Rachel" (warm female), "Domi" (professional female)
# For Indian accent: Clone a voice or use multilingual_v2 model

# ── Azure TTS (Text-to-Speech — Fallback for Regional Languages) ──
AZURE_TTS_KEY=your-azure-speech-key
AZURE_TTS_REGION=centralindia
# Azure voices for Indian languages:
# Tamil: ta-IN-PallaviNeural
# Telugu: te-IN-ShrutiNeural
# Kannada: kn-IN-SapnaNeural
# Malayalam: ml-IN-SobhanaNeural
# English: en-IN-NeerjaNeural

# ── Anthropic (Claude AI Brain) ──
ANTHROPIC_API_KEY=your-anthropic-api-key
# Conversation model: claude-haiku-4-5 (fast, low cost per call)
# Daily analysis model: claude-sonnet-4-6 (runs once a day)

# ── Google Sheets (Data Storage) ──
GSHEET_ID=your-google-sheet-id
GOOGLE_API_KEY=your-google-api-key
# Required sheets: Bookings, Customers, ConversationLogs, BusinessConfig, OutboundQueue

# ── WhatsApp (WATI API) ──
WATI_API_KEY=your-wati-api-key
WATI_BASE_URL=https://live-server-108478.wati.io

# ── Business Configuration ──
BUSINESS_NAME=The Blue Lagoon   # venue name in WhatsApp confirmations if the session has none
ADMIN_PHONE=+91XXXXXXXXXX       # daily report recipient (WhatsApp)
DEFAULT_LANGUAGE=en
BUSINESS_TIMEZONE=Asia/Kolkata
MAX_SILENCE_RETRIES=3
CALL_TIMEOUT_SECONDS=300
ESCALATION_PHONE=+91XXXXXXXXXX
# Manager's WhatsApp for missed-escalation alerts (sent when ESCALATION_PHONE is unset/invalid)
ESCALATION_ALERT_WHATSAPP=+91XXXXXXXXXX

# ── Hostinger MCP (hosting, domains, DNS, billing, reach, VPS, ecommerce) ──
# Used by .mcp.json via ${HOSTINGER_API_TOKEN}. Never commit the real value.
HOSTINGER_API_TOKEN=your-hostinger-api-token

# ---- SEOMonster MCP (.mcp.json) — all optional; free HTTP/technical-SEO tools work with none ----
# One-time Google auth (local machine): uvx --from seo-monster seo-monster auth
SEO_MCP_GOOGLE_OAUTH_CLIENT=~/.config/seo-monster/client_secret.json
SEO_MCP_GOOGLE_TOKEN=~/.config/seo-monster/token.json
SEO_MCP_GSC_DEFAULT_SITE=
SEO_MCP_GA4_PROPERTY_ID=
PSI_API_KEY=
CF_API_TOKEN=
CF_ZONE=
SEO_MCP_INDEXNOW_KEY=
SEO_MCP_INDEXNOW_KEY_LOCATION=
