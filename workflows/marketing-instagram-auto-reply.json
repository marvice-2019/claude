      "id": "8738dc60-7615-4495-b3c5-fe01dbf808a0",
      "name": "IG Events (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "webhookId": "fced3e69-dddc-45b4-bee6-4de8f9de2069"
