      "name": "Execute Graph Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        80
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const calls = $('Plan Graph Calls').all();\nreturn $input.all()\n  .map((r, i) => ({ r: r.json, c: calls[i]?.json || {} }))\n  .filter(({ r }) => r.error || !(r.id || r.message_id || r.success))\n  .map(({ r, c }) => ({ json: { ...c, status: 'api_error:' + c.action,\n    error: JSON.stringify(r.error || r).slice(0, 300),\n    alert_text: `IG ${c.action} failed for @${c.username || c.sender_id}: ${JSON.stringify(r.error?.message || r.error || r).slice(0, 200)}` } }));\n"
      },
