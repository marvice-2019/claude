      "id": "0925cb6a-f62b-488f-a5d7-cab686357e0b",
      "name": "Read BusinessConfig",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        660,
        200
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const biz = $input.first()?.json || {};\nconst system = `You run the Instagram inbox and comments for ${biz.business_name || 'our venue'}, a ${biz.business_type || 'restaurant/club'} in India.\nYou reply like a friendly, sharp host — human, brief, never robotic or salesy.\n\nVENUE FACTS (the ONLY facts you may state):\n- Timings: ${biz.timings || 'unknown'}\n- Menu highlights: ${biz.menu_highlights || 'unknown'}\n- Current offers: ${biz.current_offers || 'none listed'}\n- VIP options: ${biz.vip_options || 'none listed'}\n- Address: ${biz.address || 'unknown'}\n- Phone: ${biz.phone_number || 'unknown'}\n- Booking link: ${$env.BOOKING_URL || 'not available — ask them to call'}\n- Menu link: ${$env.MENU_URL || 'not available'}\n\nRULES\n1. Never invent prices, availability, dates, dishes or offers. If you don't know, say the team will confirm and set escalate=true.\n2. Never confirm a reservation yourself. Point to the booking link or phone.\n3. Reply in the user's language and script (English, Hinglish, Tanglish, Tamil, Telugu, Kannada, Malayalam, Hindi).\n4. Max one emoji. No hashtags. Never share personal data publicly.\n5. Do not promote alcohol to anyone who appears underage.\n\nFOR kind=\"comment\":\n- public_reply: <= 200 characters, 1-2 sentences, address @username naturally if given.\n- Booking / pricing / menu / availability / party or event enquiries: short public reply (\"Sent you a DM 📩\" style) AND dm_reply with the details.\n- Complaint or bad experience: public_reply = sincere apology + \"we've sent you a DM\"; dm_reply asks for date/time and a contact number; escalate=true.\n- Compliment / tag / emoji-only: warm, specific thanks. No DM.\n- Spam, scams, bots, link drops, self-promotion: hide_comment=true, no replies.\n- Abuse, hate, harassment: hide_comment=true, no replies; escalate=true only if it contains threats.\nFOR kind=\"dm\":\n- dm_reply only (public_reply empty, hide_comment false). <= 600 characters. Answer the question directly, then a clear next step.\n- Complaints, refunds, lost items, large group / corporate / event bookings, media or collab requests: helpful holding reply + escalate=true.\n\nReturn ONLY JSON:\n{\"intent\":\"booking|menu|hours_location|pricing|offer|event|complaint|compliment|spam|abuse|collab|other\",\"language\":\"en|hi|ta|te|kn|ml|other\",\"public_reply\":\"\",\"dm_reply\":\"\",\"hide_comment\":false,\"escalate\":false,\"escalation_reason\":\"\"}`;\nreturn $('Drop Meta Retries').all().map(({ json: e }) => ({ json: { event: e, claude_body: {\n  model: $env.CLAUDE_FAST_MODEL || 'claude-haiku-4-5-20251001',\n  max_tokens: 700,\n  system,\n  messages: [{ role: 'user', content: JSON.stringify({ kind: e.kind, username: e.username, text: e.text }) }],\n} } }));\n"
      },
      "id": "9e87b4e2-cdc7-434d-aa59-8c1d3cc2c89a",
      "name": "Build Reply Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.claude_body) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "9dcf7dfb-cf75-4bf4-92bd-c6790f4c2851",
      "name": "Claude — Decide Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const e = $('Build Reply Prompt').item.json.event;\nlet d;\ntry {\n  if ($json.error) throw new Error('claude_error');\n  const text = ($json.content || []).filter(b => b.type === 'text').map(b => b.text).join('');\n  d = JSON.parse(text.slice(text.indexOf('{'), text.lastIndexOf('}') + 1));\n} catch (err) {\n  // Safe fallback: acknowledge DMs, stay silent on comments, always escalate\n  d = { intent: 'other', language: 'en', public_reply: '', hide_comment: false, escalate: true,\n    dm_reply: e.kind === 'dm' ? \"Thanks for reaching out! Our team will get back to you shortly.\" : '',\n    escalation_reason: 'AI reply failed: ' + err.message };\n}\nconst s = v => String(v || '').trim();\nconst decision = {\n  intent: s(d.intent) || 'other', language: s(d.language) || 'en',\n  public_reply: e.kind === 'comment' ? s(d.public_reply).slice(0, 300) : '',\n  dm_reply: s(d.dm_reply).slice(0, 1000),\n  hide_comment: e.kind === 'comment' && d.hide_comment === true,\n  escalate: d.escalate === true, escalation_reason: s(d.escalation_reason),\n};\nif (decision.hide_comment) { decision.public_reply = ''; decision.dm_reply = ''; }\nreturn { json: { ...e, ...decision,\n  alert_text: `IG ${e.kind} from @${e.username || e.sender_id}: \"${e.text.slice(0, 200)}\" — ${decision.escalation_reason || decision.intent}` } };\n",
        "mode": "runOnceForEachItem"
      },
      "id": "f875a794-b307-454c-9679-27b21871a42a",
      "name": "Parse Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const v = $env.META_GRAPH_VERSION || 'v23.0';\nconst base = `https://graph.instagram.com/${v}`;\nconst calls = [];\nfor (const { json: d } of $input.all()) {\n  const meta = { event_id: d.event_id, kind: d.kind, username: d.username, sender_id: d.sender_id, text: d.text };\n  if (d.kind === 'dm' && d.dm_reply) {\n    calls.push({ ...meta, action: 'dm', url: `${base}/${d.ig_user_id}/messages`,\n      body: { recipient: { id: d.sender_id }, message: { text: d.dm_reply } } });\n  }\n  if (d.kind === 'comment') {\n    if (d.hide_comment) calls.push({ ...meta, action: 'hide', url: `${base}/${d.comment_id}`, body: { hide: true } });\n    if (d.public_reply) calls.push({ ...meta, action: 'public_reply', url: `${base}/${d.comment_id}/replies`, body: { message: d.public_reply } });\n    // Private reply: one DM per comment, allowed within 7 days of the comment\n    if (d.dm_reply) calls.push({ ...meta, action: 'private_reply', url: `${base}/${d.ig_user_id}/messages`,\n      body: { recipient: { comment_id: d.comment_id }, message: { text: d.dm_reply } } });\n  }\n}\nreturn calls.map(json => ({ json }));\n"
      },
      "id": "ba3a94ff-9109-4efa-b2a8-e47b6d19f956",
      "name": "Plan Graph Calls",
      "type": "n8n-nodes-base.code",
