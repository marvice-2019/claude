    {
      "parameters": {
        "jsCode": "if (String($env.IG_AUTOREPLY_ENABLED || 'true').toLowerCase() === 'false') return [];\nconst item = $input.first();\nlet body = item.json.body;\nconst secret = $env.META_APP_SECRET;\nif (secret) {\n  // Fail closed: unsigned or tampered payloads are dropped\n  const crypto = require('crypto');\n  const sig = String((item.json.headers || {})['x-hub-signature-256'] || '');\n  let raw;\n  try { raw = await this.helpers.getBinaryDataBuffer(0, 'data'); } catch (e) { return []; }\n  const expected = 'sha256=' + crypto.createHmac('sha256', secret).update(raw).digest('hex');\n  if (sig.length !== expected.length || !crypto.timingSafeEqual(Buffer.from(sig), Buffer.from(expected))) return [];\n  if (!body || typeof body !== 'object' || !body.entry) body = JSON.parse(raw.toString('utf8'));\n}\nif (!body || body.object !== 'instagram') return [];\nconst myId = String($env.IG_USER_ID || '');\nconst out = [];\nfor (const entry of body.entry || []) {\n  const igId = String(entry.id || myId);\n  for (const m of entry.messaging || []) {\n    const msg = m.message;\n    const sender = String(m.sender?.id || '');\n    // Skip echoes of our own messages, deletes, reactions/read receipts and non-text\n    if (!msg || msg.is_echo || msg.is_deleted || !sender || sender === igId || sender === myId) continue;\n    const text = String(msg.text || '').trim();\n    if (!text) continue;\n    out.push({ json: { event_id: 'dm_' + msg.mid, kind: 'dm', ig_user_id: igId, sender_id: sender, username: '',\n      text: text.slice(0, 1000), comment_id: '', media_id: '', received_at: new Date(m.timestamp || Date.now()).toISOString() } });\n  }\n  for (const ch of entry.changes || []) {\n    if (ch.field !== 'comments') continue;\n    const v = ch.value || {};\n    const from = String(v.from?.id || '');\n    // Never respond to our own replies — prevents reply loops\n    if (!v.id || from === igId || from === myId) continue;\n    const text = String(v.text || '').trim();\n    if (!text) continue;\n    out.push({ json: { event_id: 'c_' + v.id, kind: 'comment', ig_user_id: igId, sender_id: from, username: v.from?.username || '',\n      text: text.slice(0, 1000), comment_id: v.id, media_id: v.media?.id || '', received_at: new Date().toISOString() } });\n  }\n}\nreturn out;\n"
      },
      "id": "fe9eca87-d2fd-4c7e-97c0-49e0c5139502",
      "name": "Verify Signature & Normalize",
