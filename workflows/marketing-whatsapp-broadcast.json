    {
      "parameters": {
        "jsCode": "const campaign = $('Pick Due WhatsApp Campaign').first().json;\nconst items = $input.all().map(i => i.json).filter(j => !j.empty);\nconst sent = items.reduce((s, j) => s + (j.sent || 0), 0);\nconst failed = items.reduce((s, j) => s + (j.failed || 0), 0);\nconst errors = items.filter(j => j.error).map(j => `chunk ${j.chunk_index}: ${j.error}`);\nconst status = failed === 0 ? 'sent' : sent > 0 ? 'partially_sent' : 'failed';\nreturn [{ json: {\n  campaign_id: campaign.campaign_id,\n  status,\n  sent_count: sent,\n  failed_count: failed,\n  notes: sent + failed === 0 ? 'No eligible recipients (opt-in, segment, frequency cap)' : errors.join(' | ').slice(0, 500),\n  sent_phones: items.flatMap(j => j.phones || []),\n  alert: status !== 'sent',\n  alert_text: `WhatsApp campaign ${campaign.campaign_id} ${status}: ${sent} sent, ${failed} failed. ${errors[0] || ''}`,\n} }];\n"
      },
