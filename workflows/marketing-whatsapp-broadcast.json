    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nif (b.owner === true || b.eventType && !String(b.eventType).toLowerCase().includes('message')) return [];\nconst text = String(b.text || b.data?.text || '').trim().toUpperCase().replace(/[^A-Z ]/g, '');\nconst waId = String(b.waId || b.whatsappNumber || '').replace(/\\D/g, '');\nif (!waId) return [];\nconst STOP = ['STOP', 'UNSUBSCRIBE', 'STOP PROMOTIONS', 'STOP ALL', 'OPT OUT'];\nconst START = ['START', 'SUBSCRIBE', 'UNSTOP', 'OPT IN'];\nlet action = null;\nif (STOP.includes(text)) action = 'opt_out';\nelse if (START.includes(text)) action = 'opt_in';\nif (!action) return [];\nreturn [{ json: {\n  phone: '+' + waId,\n  waId,\n  action,\n  wa_opt_out: action === 'opt_out' ? 'TRUE' : 'FALSE',\n  wa_opt_in: action === 'opt_in' ? 'TRUE' : 'FALSE',\n  consent_source: 'whatsapp_reply',\n  consent_updated_at: new Date().toISOString(),\n  reply: action === 'opt_out'\n    ? \"You're unsubscribed from offers and updates. Booking confirmations will still reach you. Reply START anytime to opt back in.\"\n    : \"You're subscribed again. We'll keep it to the good stuff. Reply STOP anytime to unsubscribe.\",\n} }];\n"
      },
