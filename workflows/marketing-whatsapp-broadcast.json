    {
      "parameters": {
        "jsCode": "const truthy = v => ['true', 'yes', 'y', '1'].includes(String(v ?? '').trim().toLowerCase());\nconst TZ = $env.BUSINESS_TZ_OFFSET || '+05:30';\n// Sheets returns \"2026-10-10 19:00\", ISO strings, or a date serial. Bare times are venue-local (IST).\nfunction parseWhen(v) {\n  if (v === undefined || v === null || v === '') return null;\n  if (typeof v === 'number') {\n    const sign = TZ.startsWith('-') ? -1 : 1;\n    const [h, m] = TZ.slice(1).split(':').map(Number);\n    return new Date((v - 25569) * 864e5 - sign * (h * 60 + (m || 0)) * 6e4);\n  }\n  let s = String(v).trim().replace(' ', 'T');\n  if (/^\\d{4}-\\d{2}-\\d{2}$/.test(s)) s += 'T00:00';\n  if (!/([zZ]|[+-]\\d{2}:?\\d{2})$/.test(s)) s += TZ;\n  const d = new Date(s);\n  return isNaN(d) ? null : d;\n}\n\nfunction segmentOf(c) {\n  const visits = Number(c.total_visits) || 0;\n  const last = parseWhen(c.last_visit);\n  const days = last ? (Date.now() - last) / 864e5 : Infinity;\n  if (visits > 0 && days > Number($env.LAPSED_AFTER_DAYS || 45)) return 'lapsed';\n  if (visits >= Number($env.VIP_MIN_VISITS || 5)) return 'vip';\n  if (visits <= 1) return 'new';\n  return 'regular';\n}\nfunction birthdayWithin(c, days) {\n  const m = String(c.birthday || '').match(/(\\d{1,4})[-\\/](\\d{1,2})(?:[-\\/](\\d{1,4}))?/);\n  if (!m) return false;\n  // Accept YYYY-MM-DD, DD-MM-YYYY or DD-MM\n  let month, day;\n  if (m[1].length === 4) { month = +m[2]; day = +m[3]; } else { day = +m[1]; month = +m[2]; }\n  const now = new Date();\n  for (let i = 0; i <= days; i++) {\n    const d = new Date(now.getTime() + i * 864e5);\n    if (d.getMonth() + 1 === month && d.getDate() === day) return true;\n  }\n  return false;\n}\nfunction matchesSegment(c, seg) {\n  seg = String(seg || 'all').trim().toLowerCase();\n  if (seg === 'all' || seg === '') return true;\n  if (seg === 'birthday') return birthdayWithin(c, 7);\n  return segmentOf(c) === seg;\n}\n\nconst campaign = $('Pick Due WhatsApp Campaign').first().json;\nconst capDays = Number($env.MARKETING_FREQUENCY_CAP_DAYS || 3);\nconst cc = String($env.DEFAULT_COUNTRY_CODE || '91');\nconst businessName = $env.BUSINESS_NAME || '';\nlet paramSpec = [];\ntry { paramSpec = campaign.template_params ? JSON.parse(campaign.template_params) : []; } catch (e) {\n  throw new Error(`Campaign ${campaign.campaign_id}: template_params is not valid JSON`);\n}\nconst seen = new Set();\nconst receivers = [];\nfor (const { json: c } of $input.all()) {\n  if (!truthy(c.wa_opt_in) || truthy(c.wa_opt_out)) continue;\n  let digits = String(c.phone || '').replace(/\\D/g, '');\n  if (digits.length === 10) digits = cc + digits;\n  if (digits.length < 11 || digits.length > 15 || seen.has(digits)) continue;\n  if (!matchesSegment(c, campaign.segment)) continue;\n  const last = parseWhen(c.last_promo_at);\n  if (last && (Date.now() - last) / 864e5 < capDays) continue;\n  seen.add(digits);\n  const name = String(c.name || '').trim() || 'there';\n  const vars = { first_name: name.split(/\\s+/)[0], name, offer: campaign.offer || '', business_name: businessName };\n  const fill = v => String(v ?? '').replace(/\\{(\\w+)\\}/g, (m, k) => (k in vars ? vars[k] : m));\n  receivers.push({\n    sheetPhone: c.phone,\n    whatsappNumber: digits,\n    customParams: paramSpec.map(p => ({ name: String(p.name), value: fill(p.value) })),\n  });\n}\nconst base = { campaign_id: campaign.campaign_id, template_name: campaign.template_name,\n  broadcast_name: `${campaign.campaign_id}_${new Date().toISOString().slice(0, 10)}` };\nif (!receivers.length) return [{ json: { ...base, empty: true, receivers: [], phones: [] } }];\nconst out = [];\nfor (let i = 0; i < receivers.length; i += 100) {\n  const chunk = receivers.slice(i, i + 100);\n  out.push({ json: { ...base, chunk_index: i / 100,\n    receivers: chunk.map(({ whatsappNumber, customParams }) => ({ whatsappNumber, customParams })),\n    phones: chunk.map(r => r.sheetPhone) } });\n}\nreturn out;\n"
      },
