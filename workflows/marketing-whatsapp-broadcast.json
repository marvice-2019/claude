      "id": "20810d77-f0e9-4e2c-b3b8-208a22a456d5",
      "name": "Read Campaigns",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const truthy = v => ['true', 'yes', 'y', '1'].includes(String(v ?? '').trim().toLowerCase());\nconst TZ = $env.BUSINESS_TZ_OFFSET || '+05:30';\n// Sheets returns \"2026-10-10 19:00\", ISO strings, or a date serial. Bare times are venue-local (IST).\nfunction parseWhen(v) {\n  if (v === undefined || v === null || v === '') return null;\n  if (typeof v === 'number') {\n    const sign = TZ.startsWith('-') ? -1 : 1;\n    const [h, m] = TZ.slice(1).split(':').map(Number);\n    return new Date((v - 25569) * 864e5 - sign * (h * 60 + (m || 0)) * 6e4);\n  }\n  let s = String(v).trim().replace(' ', 'T');\n  if (/^\\d{4}-\\d{2}-\\d{2}$/.test(s)) s += 'T00:00';\n  if (!/([zZ]|[+-]\\d{2}:?\\d{2})$/.test(s)) s += TZ;\n  const d = new Date(s);\n  return isNaN(d) ? null : d;\n}\n\nconst now = new Date();\nconst due = $input.all()\n  .map(i => i.json)\n  .filter(c => String(c.channel).trim().toLowerCase() === 'whatsapp'\n    && String(c.status).trim().toLowerCase() === 'approved'\n    && c.campaign_id && c.template_name)\n  .map(c => ({ ...c, _when: parseWhen(c.send_at) }))\n  .filter(c => c._when && c._when <= now)\n  .sort((a, b) => a._when - b._when);\n// One campaign per run keeps throughput and Meta quality rating predictable\nif (!due.length) return [];\nconst { _when, ...c } = due[0];\nreturn [{ json: c }];\n"
      },
