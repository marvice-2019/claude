    {
      "parameters": {
        "jsCode": "const chunk = $('Loop Chunks').item.json;\nconst r = $json;\nconst ok = r && r.result === true && !r.error;\nreturn { json: {\n  campaign_id: chunk.campaign_id,\n  chunk_index: chunk.chunk_index,\n  phones: ok ? chunk.phones : [],\n  sent: ok ? chunk.phones.length : 0,\n  failed: ok ? 0 : chunk.phones.length,\n  error: ok ? '' : JSON.stringify(r.error || r.info || r).slice(0, 300),\n} };\n",
        "mode": "runOnceForEachItem"
      },
      "id": "bd0535ca-e655-431a-af4b-f6e7c1442c5e",
      "name": "Tag Chunk Result",
