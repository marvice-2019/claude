      "id": "8c4cf924-31a8-4bc5-aaea-d7a6164a1dde",
      "name": "Claude — Write Captions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        -100
      ],
      "retryOnFail": true,
