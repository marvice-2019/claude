      "id": "27390bcd-a281-4972-bf3b-47cd2923da68",
      "name": "IG: Create Container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        -120
      ],
      "retryOnFail": true,
