      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const { post: p, needs_caption } = $('Build Caption Prompt').item.json;\nlet ig = p.caption, fb = p.caption, error = '';\nif (needs_caption) {\n  try {\n    if ($json.error) throw new Error(JSON.stringify($json.error).slice(0, 200));\n    const text = ($json.content || []).filter(b => b.type === 'text').map(b => b.text).join('');\n    const j = JSON.parse(text.slice(text.indexOf('{'), text.lastIndexOf('}') + 1));\n    ig = j.instagram_caption; fb = j.facebook_caption || j.instagram_caption;\n    if (!ig) throw new Error('empty caption');\n  } catch (e) { error = 'Caption generation failed: ' + e.message; }\n}\nconst platforms = String(p.platforms || '').toLowerCase();\nconst format = String(p.format || 'image').trim().toLowerCase();\nconst media = String(p.media_url || '').trim();\nif (!error && format !== 'text' && !/^https:\\/\\//.test(media)) error = 'media_url must be a public https URL';\nconst to_instagram = platforms.includes('instagram') && format !== 'text';\nconst to_facebook = platforms.includes('facebook');\nconst ig_container_body = format === 'reel'\n  ? { media_type: 'REELS', video_url: media, caption: ig, share_to_feed: true }\n  : { image_url: media, caption: ig };\nconst fb_edge = format === 'reel' ? 'videos' : format === 'text' ? 'feed' : 'photos';\nconst fb_body = format === 'reel' ? { file_url: media, description: fb }\n  : format === 'text' ? { message: fb } : { url: media, message: fb };\nreturn { json: { post_id: p.post_id, format, to_instagram, to_facebook, caption_used: ig || '',\n  ig_container_body, fb_edge, fb_body, error, ig_error: '', fb_error: '', ig_media_id: '', fb_post_id: '' } };\n",
        "mode": "runOnceForEachItem"
      },
