    {
      "parameters": {
        "jsCode": "const errors = [$json.error, $json.ig_error, $json.fb_error].filter(Boolean);\nconst anyPosted = !!($json.ig_media_id || $json.fb_post_id);\nconst status = !errors.length ? 'posted' : anyPosted ? 'partially_posted' : 'failed';\nreturn { json: { ...$json, status, error_text: errors.join(' | ').slice(0, 500),\n  alert: status !== 'posted', alert_text: `Social post ${$json.post_id} ${status}: ${errors.join(' | ').slice(0, 300)}` } };\n",
