    {
      "parameters": {
        "jsCode": "const post = $('Post to Instagram?').item.json;\nconst id = $json.id;\nif (!id) return { json: { ...post, ig_error: 'IG container: ' + JSON.stringify($json.error || $json).slice(0, 300) } };\n// Images are ready immediately; reels need transcoding. Poll up to ~4 min (Code node timeout is 5 min).\nconst version = $env.META_GRAPH_VERSION || 'v23.0';\nfor (let i = 0; i < 24; i++) {\n  const r = await this.helpers.httpRequest({\n    method: 'GET', url: `https://graph.instagram.com/${version}/${id}`,\n    qs: { fields: 'status_code', access_token: $env.IG_ACCESS_TOKEN }, json: true,\n  });\n  if (r.status_code === 'FINISHED') return { json: { ...post, ig_creation_id: id } };\n  if (r.status_code === 'ERROR' || r.status_code === 'EXPIRED') return { json: { ...post, ig_error: `IG container ${r.status_code}` } };\n  await new Promise(res => setTimeout(res, 10000));\n}\nreturn { json: { ...post, ig_error: 'IG container not ready after 4 min' } };\n",
        "mode": "runOnceForEachItem"
      },
