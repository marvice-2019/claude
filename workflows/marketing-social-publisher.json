        "jsCode": "const post = $('Post to Facebook?').item.json;\nconst id = $json.post_id || $json.id;\nif (id) return { json: { ...post, fb_post_id: String(id) } };\nreturn { json: { ...post, fb_error: 'FB publish: ' + JSON.stringify($json.error || $json).slice(0, 300) } };\n",
