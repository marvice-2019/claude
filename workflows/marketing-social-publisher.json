        "jsCode": "const post = $('IG: Wait Until Ready').item.json;\nif (post.ig_error) return { json: post };\nif ($json.id) return { json: { ...post, ig_media_id: String($json.id) } };\nreturn { json: { ...post, ig_error: 'IG publish: ' + JSON.stringify($json.error || $json).slice(0, 300) } };\n",
