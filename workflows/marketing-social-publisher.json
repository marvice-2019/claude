    {
      "parameters": {
        "jsCode": "const biz = $input.first()?.json || {};\nconst system = `You are the social media lead for ${biz.business_name || 'a hospitality venue'} (${biz.business_type || 'restaurant/club'}, India).\nWrite scroll-stopping captions that drive visits and bookings.\nRules:\n- Use ONLY the facts provided. Never invent prices, dates, dishes or offers.\n- instagram_caption: hook in the first line (<= 8 words), 2-4 short lines, a clear CTA (\"Book via link in bio\" / \"DM us to reserve\"), then a blank line and 5-10 relevant hashtags mixing local (city/area) and niche. <= 2 emojis in the body.\n- facebook_caption: 1-3 sentences, conversational, include the booking URL if provided, max 2 hashtags.\n- Match the language of the brief (English, Hinglish, Tamil, etc.).\nReturn ONLY JSON: {\"instagram_caption\": \"...\", \"facebook_caption\": \"...\"}`;\nreturn $('Pick Due Posts').all().map(({ json: p }) => {\n  const needs_caption = !String(p.caption || '').trim();\n  return { json: { post: p, needs_caption, claude_body: needs_caption ? {\n    model: $env.CLAUDE_MARKETING_MODEL || 'claude-sonnet-5-5',\n    max_tokens: 1200,\n    system,\n    messages: [{ role: 'user', content: JSON.stringify({\n      brief: p.brief, format: p.format || 'image', platforms: p.platforms,\n      booking_url: $env.BOOKING_URL || '', menu_url: $env.MENU_URL || '',\n      venue: { name: biz.business_name, timings: biz.timings, menu_highlights: biz.menu_highlights,\n        current_offers: biz.current_offers, address: biz.address },\n    }, null, 2) }],\n  } : null } };\n});\n"
      },
