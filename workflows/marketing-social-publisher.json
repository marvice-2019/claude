    {
      "parameters": {
        "jsCode": "const truthy = v => ['true', 'yes', 'y', '1'].includes(String(v ?? '').trim().toLowerCase());\nconst TZ = $env.BUSINESS_TZ_OFFSET || '+05:30';\n// Sheets returns \"2026-10-10 19:00\", ISO strings, or a date serial. Bare times are venue-local (IST).\nfunction parseWhen(v) {\n  if (v === undefined || v === null || v === '') return null;\n  if (typeof v === 'number') {\n    const sign = TZ.startsWith('-') ? -1 : 1;\n    const [h, m] = TZ.slice(1).split(':').map(Number);\n    return new Date((v - 25569) * 864e5 - sign * (h * 60 + (m || 0)) * 6e4);\n  }\n  let s = String(v).trim().replace(' ', 'T');\n  if (/^\\d{4}-\\d{2}-\\d{2}$/.test(s)) s += 'T00:00';\n  if (!/([zZ]|[+-]\\d{2}:?\\d{2})$/.test(s)) s += TZ;\n  const d = new Date(s);\n  return isNaN(d) ? null : d;\n}\n\nconst now = new Date();\nreturn $input.all().map(i => i.json)\n  .filter(p => String(p.status).trim().toLowerCase() === 'approved' && p.post_id)\n  .map(p => ({ ...p, _when: parseWhen(p.publish_at) }))\n  .filter(p => p._when && p._when <= now)\n  .sort((a, b) => a._when - b._when)\n  .slice(0, 3)\n  .map(({ _when, ...p }) => ({ json: p }));\n"
      },
