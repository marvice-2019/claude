          }
        ]
      ]
    },
    "Found?": {
      "main": [
        [
          {
            "node": "Send Audio",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Fixed Phrase?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fixed Phrase?": {
      "main": [
        [
          {
            "node": "Sarvam TTS",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Not Found",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sarvam TTS": {
      "main": [
        [
          {
            "node": "TTS OK?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "TTS OK?": {
      "main": [
        [
          {
            "node": "Store Audio",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Not Found",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Store Audio": {
      "main": [
        [
          {
            "node": "Generated To Binary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generated To Binary": {
      "main": [
        [
          {
            "node": "Send Audio",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "timezone": "Asia/Kolkata"
  }
}
