        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  template_name: 'booking_confirmation',\n  broadcast_name: 'voice_agent_booking',\n  parameters: [\n    { name: 'customer_name', value: String($('Parse Booking Data').first().json.booking_name || 'Valued Guest') },\n    { name: 'date', value: String($('Parse Booking Data').first().json.booking_date || '') },\n    { name: 'time', value: String($('Parse Booking Data').first().json.booking_time || '') },\n    { name: 'guests', value: String($('Parse Booking Data').first().json.booking_guests || '') },\n    { name: 'venue', value: String($('Parse Booking Data').first().json.business_name || $env.BUSINESS_NAME || 'us') }\n  ]\n}) }}",
