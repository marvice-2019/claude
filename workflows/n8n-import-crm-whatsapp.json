      "id": "b98b751b-e1bd-4b39-9f0a-84b478e4125f",
      "name": "Check Lead Handoff",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1320, 400],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "notes": "Reads the guest's row in the Handoffs sheet. No row or a Sheets error both mean 'not paused'."
    },
    {
      "parameters": {
        "jsCode": "// Skip the automated lead follow-up while staff are handling this guest.\nconst lead = $('Parse Lead Data').first().json;\nconst key = `${lead.business_id || 'default'}:${String(lead.lead_phone || '').replace(/\\D/g, '')}`;\nconst row = $input.all().map(i => i.json)\n  .find(r => String(r.handoff_key || '') === key && String(r.status || '').trim().toLowerCase() === 'active');\nlet paused = false;\nif (row) {\n  const until = Date.parse(String(row.paused_until || ''));\n  paused = Number.isNaN(until) ? true : until > Date.now();\n}\nreturn [{ json: { ...lead, bot_paused: paused } }];\n"
      },
      "id": "b6bcfae0-62c9-4ef5-8de2-51a643865804",
      "name": "Evaluate Lead Handoff",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
