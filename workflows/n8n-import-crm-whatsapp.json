        "documentId": { "__rl": true, "mode": "id", "value": "={{ $env.GSHEET_ID }}" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Handoffs" },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "handoff_key",
              "lookupValue": "={{ ($('Parse Lead Data').first().json.business_id || 'default') + ':' + String($('Parse Lead Data').first().json.lead_phone || '').replace(/\\D/g, '') }}"
            }
