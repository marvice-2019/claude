      "parameters": {
        "jsCode": "// Sheets returns the saved row; report the request's own outcome to the activity log.\nconst h = $('Build Handoff Row').first().json;\nreturn [{ json: {\n  action: h.action,\n  session_id: h.session_id,\n  business_id: h.business_id,\n  caller_number: h.caller_number,\n  status: h.has_phone ? h.log_status : `${h.log_status}; handoff_skipped_no_phone`,\n  handoff_key: h.handoff_key,\n  paused_until: h.paused_until\n} }];\n"
      },
      "id": "36cca37e-221f-4ae6-a22f-d6380be244c2",
