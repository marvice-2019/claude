    {
      "parameters": {
        "jsCode": "// Unknown action fallback\nconst s = $input.first().json;\nreturn [{ json: {\n  action: s.action || 'UNKNOWN',\n  session_id: s.session_id,\n  business_id: s.business_id,\n  status: 'unknown_action_ignored'\n}}];\n"
      },
      "id": "crm-050",
      "name": "Unknown Action Handler",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 800]
    },
    {
      "parameters": {
        "jsCode": "// Only n8n's own workflows may call crm-action: it saves to Sheets and sends WhatsApp\n// templates to any number it is given. Callers send X-Internal-Token = INTERNAL_WEBHOOK_TOKEN.\n// Fails closed: an unset or short (<16 chars) token rejects every request.\nconst req = $input.first().json;\nconst expected = String($env.INTERNAL_WEBHOOK_TOKEN || '');\nconst provided = String((req.headers || {})['x-internal-token'] || '');\n\n// Constant-time compare so the token can't be guessed one character at a time.\nconst n = Math.max(expected.length, provided.length);\nlet diff = expected.length ^ provided.length;\nfor (let i = 0; i < n; i++) diff |= (expected.charCodeAt(i) || 0) ^ (provided.charCodeAt(i) || 0);\nconst configured = expected.length >= 16;\nconst authorized = configured && provided.length > 0 && diff === 0;\n\nreturn [{ json: {\n  ...req,\n  request_allowed: authorized,\n  auth_reason: !configured ? 'token_not_configured' : (!provided ? 'missing_token' : (authorized ? 'ok' : 'token_mismatch'))\n} }];\n"
      },
      "id": "b6d4c5cc-a1a8-4a5a-9fb0-54b69337ec6b",
      "name": "Verify Internal Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "d59f7c8c-e7cd-41b9-893e-eba3db24d422",
              "leftValue": "={{ $json.request_allowed }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "895394b2-1d17-44cd-9b18-e9484fbb5747",
      "name": "Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
