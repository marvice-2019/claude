      "id": "crm-012",
      "name": "WhatsApp Booking Confirmation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 200],
      "notes": "Reads from 'Parse Booking Data': the Google Sheets step before this node outputs the saved row, not the booking/call data."
    },
    {
      "parameters": {
        "jsCode": "// Handle WhatsApp send failure — mark for retry\nconst s = $input.first().json;\n// WATI's response has no session; take it from the CRM request data\nconst ctx = $('Parse Booking Data').first().json;\nconst success = s.statusCode === 200 || s.result === true;\n\nreturn [{ json: {\n  action: 'CONFIRM_BOOKING',\n  session_id: ctx.session_id,\n  business_id: ctx.business_id,\n  whatsapp_sent: success,\n  status: success ? 'completed' : 'whatsapp_failed_retry'\n}}];\n"
      },
      "id": "crm-013",
      "name": "Check WhatsApp Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 200]
    },
