      "id": "b8c5c228-033f-4860-b93e-d8f9158d1030",
      "name": "Reject Unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, 640]
    },
    {
      "parameters": {
        "jsCode": "// One row per guest per venue in the Handoffs sheet (upserted on handoff_key).\n// While status = active and paused_until is in the future: no automated lead follow-ups,\n// and a repeat call goes straight to staff. Staff end it early by setting status = released.\nconst ctx = $('Extract CRM Data').first().json;\nconst prev = $input.first().json;\nconst digits = String(ctx.caller_number || '').replace(/\\D/g, '');\nconst hours = Number($env.HANDOFF_PAUSE_HOURS) > 0 ? Number($env.HANDOFF_PAUSE_HOURS) : 24;\nconst now = new Date();\n\nreturn [{ json: {\n  action: ctx.action,\n  session_id: ctx.session_id,\n  business_id: ctx.business_id,\n  caller_number: ctx.caller_number,\n  log_status: prev.status || 'handoff_active',\n  has_phone: digits !== '',\n  handoff_key: `${ctx.business_id || 'default'}:${digits}`,\n  phone: ctx.caller_number,\n  status: 'active',\n  reason: ctx.action === 'COMPLAINT' ? 'complaint' : (ctx.handoff_reason || 'transfer_to_human'),\n  source: ctx.action === 'COMPLAINT' ? 'complaint' : (ctx.handoff_source || 'voice_agent'),\n  started_at: now.toISOString(),\n  paused_until: new Date(now.getTime() + hours * 3600 * 1000).toISOString(),\n  released_by: ''\n} }];\n"
      },
      "id": "b3f8b863-d732-40d5-b362-0aa03935d99a",
      "name": "Build Handoff Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
