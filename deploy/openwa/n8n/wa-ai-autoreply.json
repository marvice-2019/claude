    {
      "id": "0191ff23-9da5-4b22-a353-9aca0b85e001",
      "name": "Decide Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        0
      ],
      "parameters": {
        "jsCode": "// Decide what to do with a customer message using the chat's bot state.\nconst m = $('Classify Event').first().json;\nconst s = $input.first().json || {};\nconst t = m.text.toLowerCase().trim();\nlet action = 'ai';\nif (s.last_msg_id && s.last_msg_id === m.msgId) action = 'duplicate';\nelse if (/^(stop|unsubscribe|stop all|opt out|optout)\\.?$/.test(t)) action = 'stop';\nelse if (s.paused_until && new Date(s.paused_until) > new Date()) action = 'paused';\nelse if (/\\b(human|real person|agent|manager|owner|staff|talk to (someone|somebody|a person)|call me)\\b/.test(t)) action = 'human';\nreturn [{ json: { ...m, action, pausedUntil: s.paused_until || '' } }];\n"
      }
    },
