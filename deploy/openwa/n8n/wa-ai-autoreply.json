    {
      "id": "ff1cbe35-e5cd-4420-9e24-7d483de6b2d4",
      "name": "Classify Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Classify the OpenWA webhook. Only fresh 1:1 customer messages reach the AI; staff can type\n// \"#bot off\" / \"#bot on\" from the business phone to pause or resume the bot in that chat.\nconst b = $input.first().json.body || {};\nconst d = b.data || {};\nconst ev = b.event;\nconst chatId = String(d.chatId || d.from || '');\nconst text = String(d.body || '').trim();\nconst ageSec = d.timestamp ? Date.now() / 1000 - Number(d.timestamp) : 0;\nconst out = { event: ev, chatId, msgId: String(d.id || b.idempotencyKey || ''), text, type: d.type || 'text',\n  phone: chatId.endsWith('@c.us') ? chatId.split('@')[0] : '', route: 'ignore', reason: '' };\n\nconst staff = text.match(/^#bot\\s+(on|off)\\b/i);\nif (ev === 'message.sent' && d.fromMe && staff) {\n  out.route = 'staff'; out.staffCommand = staff[1].toLowerCase();\n} else if (ev !== 'message.received') out.reason = `event ${ev}`;\nelse if (d.fromMe) out.reason = 'own message';\nelse if (d.isGroup || d.isStatusBroadcast || /@g\\.us$|broadcast|@newsletter$/.test(chatId)) out.reason = 'not a 1:1 chat';\nelse if (['revoked', 'call', 'poll', 'reaction'].includes(out.type)) out.reason = `type ${out.type}`;\nelse if (ageSec > 300) out.reason = 'older than 5 min (backlog replay)';\nelse if (!chatId) out.reason = 'no chat id';\nelse {\n  out.route = 'customer';\n  if (out.type !== 'text' || !text) {\n    out.text = `(The customer sent a ${out.type}${text ? ` with caption \"${text}\"` : ''}. You cannot open attachments: ask them to type their question, or say a team member will look at it.)`;\n  }\n}\nreturn [{ json: out }];\n"
      }
    },
