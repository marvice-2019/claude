    {
      "id": "931a75bd-aad8-44fc-92ee-eaa9dad3f040",
      "name": "Clean AI Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1880,
        -200
      ],
      "parameters": {
        "jsCode": "// Clean the model reply for WhatsApp and detect the handoff marker.\nconst m = $('Decide Action').first().json;\nlet reply = String($input.first().json.output || '').trim();\n// Empty output = the model call failed (outage, rate limit): hand off instead of going silent.\nconst handoff = reply.includes('<<HANDOFF>>') || !reply;\nreply = reply.replace(/<<HANDOFF>>/g, '').replace(/\\*\\*(.+?)\\*\\*/g, '*$1*').replace(/^#+\\s*/gm, '').trim();\nif (!reply) reply = 'Thanks for your message! A team member will reply here shortly 🙏';\nif (reply.length > 1500) reply = reply.slice(0, 1490).replace(/\\s+\\S*$/, '') + ' …';\nreturn [{ json: { to: m.chatId, text: reply, handoff } }];\n"
      }
    },
