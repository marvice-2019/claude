    {
      "id": "25f392f1-ab0c-4ae1-a7c9-c71673517834",
      "name": "Handoff Messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2560,
        60
      ],
      "parameters": {
        "jsCode": "// Customer acknowledgement + owner alert. Bot stays paused in this chat until it expires or staff types \"#bot on\".\nconst OWNER = 'REPLACE_WITH_OWNER_NUMBER'; // e.g. 919876543210 (digits only)\nconst m = $('Decide Action').first().json;\nconst ai = $('Clean AI Reply').isExecuted ? $('Clean AI Reply').first().json.text : '';\nconst out = [{ json: { to: m.chatId, text: ai || \"Sure, I've asked a team member to take over. They'll reply here shortly 🙏\" } }];\nif (/^\\d{10,15}$/.test(OWNER)) {\n  out.push({ json: { to: `${OWNER}@c.us`, text: `🔔 Customer needs a human\\nChat: ${m.phone || m.chatId}\\nLast message: \"${m.text.slice(0, 300)}\"\\n\\nBot is paused there for 12h. Reply from the business phone; type \"#bot on\" in that chat to hand back.` } });\n}\nreturn out;\n"
      }
    },
