# Copy to .env (deploy.sh does this and fills secrets automatically).
N8N_DOMAIN=n8n.marvice.tech
ACME_EMAIL=marvice2019@gmail.com
TZ=Asia/Kolkata
N8N_VERSION=stable

POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_PASSWORD=
# Back this up offline. Losing it = every stored credential in n8n is unrecoverable.
N8N_ENCRYPTION_KEY=

# Set by deploy.sh: bundled Traefik vs. one already running on the host.
TRAEFIK_NETWORK=n8n_edge
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=le
