# n8n production stack — copy to .env (never commit .env)
#   openssl rand -hex 32   → use for N8N_ENCRYPTION_KEY and POSTGRES_PASSWORD

# ── Stack ──
N8N_VERSION=2.41.6
N8N_HOST=n8n.yourdomain.com          # DNS A record → VPS IP, no https://, no trailing slash
ACME_EMAIL=you@yourdomain.com        # Let's Encrypt expiry notices
GENERIC_TIMEZONE=Asia/Kolkata
WORKER_CONCURRENCY=10
EXECUTIONS_DATA_MAX_AGE=336          # hours (14 days)

# Losing this key = every saved credential is unrecoverable. Store it in your password manager.
N8N_ENCRYPTION_KEY=
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=

# ── Voice agent secrets (read by workflows as $env.*) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
AZURE_TTS_KEY=
AZURE_TTS_REGION=
ANTHROPIC_API_KEY=
GSHEET_ID=
GOOGLE_API_KEY=
WATI_API_KEY=
WATI_BASE_URL=

# ── Business ──
BUSINESS_NAME=
ADMIN_PHONE=
DEFAULT_LANGUAGE=en
BUSINESS_TIMEZONE=Asia/Kolkata
MAX_SILENCE_RETRIES=3
CALL_TIMEOUT_SECONDS=300
ESCALATION_PHONE=
ESCALATION_ALERT_WHATSAPP=
