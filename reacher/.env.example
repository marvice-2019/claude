# Public hostname for the API. DNS A/AAAA record must point at this server
# before first boot so Caddy can issue the Let's Encrypt certificate.
DOMAIN=verify.example.com
ACME_EMAIL=ops@example.com

# API key clients must send. Generate with: openssl rand -hex 32
# Hex only: the value is embedded in the Caddyfile matcher.
REACHER_API_KEY=

# SMTP identity used during verification. HELLO_NAME should match the
# server IP's reverse DNS (PTR); FROM_EMAIL should be on the same domain.
HELLO_NAME=mail.example.com
FROM_EMAIL=verify@example.com

# Per-verification SMTP timeout, seconds.
SMTP_TIMEOUT=45

BACKEND_NAME=reacher

# Optional SOCKS5 proxy (also uncomment the RCH__PROXY__* lines in docker-compose.yml)
# PROXY_HOST=
# PROXY_PORT=1080
# PROXY_USERNAME=
# PROXY_PASSWORD=
